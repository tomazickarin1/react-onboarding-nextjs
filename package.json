    "@tanstack/react-query": "^5.101.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "next": "16.3.0",
    "next-auth": "^4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
