    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-storybook": "^10.5.6",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
